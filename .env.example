# Jack Ryan — environment template. Copy to .env and fill in.
# Real values never belong in a tracked file.

# Which infrastructure profile from config.yaml to run (empty = config default)
JACKRYAN_PROFILE=

# Where casefile data lives inside the container
JACKRYAN_DATA_DIR=/data

# Optional: path to the layered config file
JACKRYAN_CONFIG=/app/config.yaml

# Where embedding model weights are cached (set in the image; defaults
# to <data dir>/models otherwise)
JACKRYAN_MODEL_CACHE=
