# Jack Ryan — layered configuration template. Copy to config.yaml (gitignored).
#
# Two layers with different lifetimes:
#   contract — corpus-coupled. Changing any value invalidates an existing
#              corpus and forces a reingest. Frozen once documents exist.
#   profiles — swappable infrastructure. Safe to change at any time.
#
# Precedence: real environment variable > this file > built-in default.

contract:
  # Every value here is read by chunking or by embedding. Changing any of them
  # changes corpus identity, and an existing store will refuse to open.
  chunk_max_chars: 2000
  chunk_overlap_chars: 200
  embed_model: intfloat/multilingual-e5-large
  embed_dimensions: 1024
  # The library that produces the vectors, pinned exactly. Verified against what
  # is installed at startup: a mismatch is fatal and names both versions. The
  # same model under two versions of this library can return vectors of the
  # declared width that are not comparable, and nothing downstream can tell.
  # Changing this value forces a reingest of every casefile.
  embed_library: fastembed==0.8.0

default_profile: local

profiles:
  local:
    # Fully offline. No endpoint required; embedding runs in-process.
    llm_url: ""
    embed_url: ""
    # "model" is the real embedder. "deterministic" produces vectors that
    # carry no meaning and exists for tests — never set it on real data.
    embedder: model
    # Which agent-facing tool surface to advertise: readonly | analyst | admin.
    # An unrecognised name narrows to readonly rather than widening.
    mcp_profile: readonly

  remote:
    # Point at your own OpenAI-compatible endpoints. Comma-separated for
    # round-robin. Secrets come from the environment, never from this file.
    llm_url: "http://localhost:8000/v1"
    embed_url: "http://localhost:8001/v1"
    api_key: ${JACKRYAN_REMOTE_API_KEY}
