# Jack Ryan — layered configuration template. Copy to config.yaml (gitignored).
#
# Two layers with different lifetimes:
#   contract — corpus-coupled. Changing any value invalidates an existing
#              corpus and forces a reingest. Frozen once documents exist.
#   profiles — swappable infrastructure. Safe to change at any time, with one
#              exception: `embedder` decides which implementation produces the
#              vectors, so changing it invalidates every vector already stored.
#              Corpus identity records it, and the store refuses a corpus filled
#              by the other one.
#
# Precedence: real environment variable > this file > built-in default.

contract:
  # Every value here is read by chunking or by embedding. Changing any of them
  # changes corpus identity, and an existing store will refuse to open.
  chunk_max_chars: 2000
  chunk_overlap_chars: 200
  embed_model: intfloat/multilingual-e5-large
  embed_dimensions: 1024
  # The library that produces the vectors, pinned exactly. Verified against what
  # is installed at startup: a mismatch is fatal and names both versions. The
  # same model under two versions of this library can return vectors of the
  # declared width that are not comparable, and nothing downstream can tell.
  # Changing this value forces a reingest of every casefile.
  embed_library: fastembed==0.8.0

default_profile: local

profiles:
  local:
    # Fully offline. No endpoint required; embedding runs in-process.
    llm_url: ""
    embed_url: ""
    # "model" is the real embedder. "deterministic" produces vectors that
    # carry no meaning and exists for tests — never set it on real data.
    embedder: model
    # Which agent-facing tool surface to advertise: readonly | analyst | admin.
    # An unrecognised name narrows to readonly rather than widening.
    mcp_profile: readonly
    # Extraction. A page-bearing document is read first with recognition off;
    # if that yields fewer than min_chars_per_page characters per page it is a
    # scan, and recognition runs. These change the text a document yields, but
    # only for documents ingested after the change, so they are not part of
    # corpus identity. Each document records which rung produced its text.
    #
    # ocr_engine is never "auto": that picks by host operating system and
    # discards the language below, so the same evidence read on two machines
    # would produce two different corpora.
    ocr_engine: rapidocr
    # One language, in the engine's own vocabulary. "eslav" is East Slavic and
    # reads Ukrainian, Russian and English off the same page.
    ocr_language: eslav
    min_chars_per_page: 100
    # A docling vision-model spec name enables the third rung, tried only when
    # recognition is also below the floor. Empty leaves it off: it downloads
    # model weights and is much slower. Example: GRANITEDOCLING_TRANSFORMERS
    vlm_model: ""

    # Retrieval. These are read at query time and write nothing — no vector, no
    # chunk, no stored text — so changing one changes the next search and leaves
    # the corpus untouched. No store is ever refused for them.
    #
    # A cross-encoder that reorders results after fusion, or empty for none.
    # Empty is the default, and it was measured rather than assumed: on the
    # project's own evaluation set both models the library registers made
    # retrieval worse, and both took Ukrainian to zero — for a Ukrainian query a
    # cross-encoder ranks English passages above the Ukrainian one that answers
    # it. See `docs/handover.md` for the figures before you name one.
    #
    # Naming a model the instance cannot build is fatal when the first search
    # needs it. A model that fails while scoring one response is not: the fused
    # order stands and the response says `rerank-unavailable`.
    reranker_model: ""
    # How many fused candidates the reranker sees. Larger than a caller's usual
    # limit on purpose: a reranker shown only what was asked for cannot improve
    # anything.
    rerank_depth: 50
    # How wide a result's text may be. A result carries a window around the
    # passage that matched, so a quotation arrives with the sentences that give
    # it meaning. Set at or below chunk_max_chars to switch widening off.
    window_max_chars: 3000

  remote:
    # Point at your own OpenAI-compatible endpoints. Comma-separated for
    # round-robin. Secrets come from the environment, never from this file.
    llm_url: "http://localhost:8000/v1"
    embed_url: "http://localhost:8001/v1"
    api_key: ${JACKRYAN_REMOTE_API_KEY}
